# ==============================================================================
# Online Reservation System - Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the container stack with Docker Compose:
#   cp .env.example .env
# Never commit real credentials, private keys, or secrets into source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Server Configuration
# ------------------------------------------------------------------------------
# The HTTP port on the host machine mapped to the application container
SERVER_PORT=8080

# Active Spring profile (e.g. prod, dev, local, staging)
SPRING_PROFILES_ACTIVE=prod

# Root and application logging levels (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Hostname of the PostgreSQL database (use 'postgres' when running inside Docker Compose)
DB_HOST=postgres

# PostgreSQL port on the host machine
DB_PORT=5432

# Database schema name created during container initialization
DB_NAME=reservation_db

# PostgreSQL superuser/application username
DB_USERNAME=postgres

# PostgreSQL password (REQUIRED: Change this in production environments!)
DB_PASSWORD=postgres

# Full JDBC connection URL (used by Flyway migrations and external connection pools)
DATABASE_URL=jdbc:postgresql://postgres:5432/reservation_db

# ------------------------------------------------------------------------------
# 3. Redis & Redisson Distributed State Configuration
# ------------------------------------------------------------------------------
# Redis host for caching, distributed locking (ShedLock), and session tokens
REDIS_HOST=redis

# Redis TCP port on the host machine
REDIS_PORT=6379

# Redis authentication password (leave empty for local dev, mandatory in production)
REDIS_PASSWORD=

# Redisson connection URI format: redis://<host>:<port>
REDISSON_ADDRESS=redis://redis:6379

# ------------------------------------------------------------------------------
# 4. JWT (JSON Web Token) Security & Authentication
# ------------------------------------------------------------------------------
# HMAC-SHA256 secret key for signing access & refresh tokens (minimum 256 bits / 32 characters)
JWT_SECRET=super-secret-jwt-signing-key-that-is-at-least-256-bits-long-change-me!

# Access token validity lifetime in minutes (short-lived access tokens)
JWT_ACCESS_EXPIRATION_MINUTES=15

# Refresh token validity lifetime in days (stored in HTTP-only cookies / DB whitelist)
JWT_REFRESH_EXPIRATION_DAYS=7

# ------------------------------------------------------------------------------
# 5. Stripe Payment Gateway & Webhook Integration
# ------------------------------------------------------------------------------
# Stripe secret API key (starts with sk_test_... or sk_live_...)
STRIPE_API_KEY=sk_test_mock_key_for_local_development

# Stripe endpoint signing secret for HMAC webhook verification (starts with whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_mock_test_secret_for_local_testing

# Stripe API base URL (override with http://stripe-mock:12111 for isolated testing)
STRIPE_BASE_URL=http://stripe-mock:12111

# ------------------------------------------------------------------------------
# 6. Email & Notification Channel Configuration (MailHog / SMTP)
# ------------------------------------------------------------------------------
# SMTP server host ('mailhog' in Docker Compose, or your production SMTP provider)
MAIL_HOST=mailhog

# SMTP server port (1025 for MailHog, 587 for TLS, 465 for SSL)
MAIL_PORT=1025

# SMTP authentication credentials (leave blank for local MailHog)
MAIL_USERNAME=
MAIL_PASSWORD=

# Default 'From' email address attached to outgoing notifications
MAIL_FROM=notifications@reservation-system.example.com

# ------------------------------------------------------------------------------
# 7. Observability, Metrics & Distributed Tracing
# ------------------------------------------------------------------------------
# Comma-separated list of Spring Boot Actuator web endpoints to expose
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,metrics,prometheus,info

# OpenTelemetry OTLP gRPC/HTTP collector trace ingestion endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Distributed trace sampling probability (1.0 = 100% trace capture, 0.1 = 10%)
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=1.0
